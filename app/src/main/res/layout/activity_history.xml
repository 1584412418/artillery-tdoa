<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/tv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button android:id="@+id/btn_export_csv" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="导出CSV"/>
    <Button android:id="@+id/btn_clear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清空记录"/>
    <Button android:id="@+id/btn_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="返回"/>
</LinearLayout>
